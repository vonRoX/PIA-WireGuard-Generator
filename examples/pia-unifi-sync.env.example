# Copy to /etc/pia-unifi-sync.env, then: chmod 600 /etc/pia-unifi-sync.env
PIA_USERNAME=p1234567
PIA_PASSWORD=your-pia-password

# Either an API key (UniFi Network 9.0+: Settings → Control Plane → Integrations)…
UNIFI_API_KEY=
# …or a dedicated local admin without multi-factor authentication.
UNIFI_USERNAME=pia-sync
UNIFI_PASSWORD=
